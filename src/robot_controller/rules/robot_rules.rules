# Robot USB Device Rules
# Using bcdDevice to distinguish CH340 devices

# ESP - CH340 chip (1a86:7523) with bcdDevice 0264
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ATTRS{bcdDevice}=="0264", MODE:="0777", SYMLINK+="esp"

# IMU - CH340 chip (1a86:7523) with bcdDevice 8233
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ATTRS{bcdDevice}=="8233", MODE:="0777", SYMLINK+="imu"

# LiDAR - CP210x chip (10c4:ea60)
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0777", SYMLINK+="lidar"
